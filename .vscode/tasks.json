{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Project",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-g",
                "-o", "${workspaceFolder}/build/MiniCloudStorage.exe",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/repositories/FileRepository.cpp",
                "-I${workspaceFolder}/json/single_include",
                "-I${workspaceFolder}/crow/include",
                "-I${workspaceFolder}/src"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}